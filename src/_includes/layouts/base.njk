{%- if seo and seo.title -%}{%- set seoTitle = seo.title -%}
{%- elif title and title.length > 44 -%}{%- set seoTitle = title -%}
{%- elif title -%}{%- set seoTitle = title ~ " | " ~ site.name -%}
{%- else -%}{%- set seoTitle = site.name ~ " | " ~ site.jobTitle -%}{%- endif -%}
{%- set seoDescription = (seo.description if (seo and seo.description) else (description or summary or site.description)) | stripHtml -%}
{%- set seoKeywords = seo.keywords if (seo and seo.keywords) else keywords -%}
{%- set shareImage = (image or site.ogImage) | abs -%}
{%- set canonical = page.url | abs -%}
<!DOCTYPE html>
<html lang="en-PK" class="no-js">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ seoTitle }}</title>
  <meta name="description" content="{{ seoDescription }}">
  {% if seoKeywords %}<meta name="keywords" content="{{ seoKeywords }}">{% endif %}
  <meta name="author" content="{{ site.fullName }}">
  <meta name="robots" content="{{ 'noindex, follow' if noindex else 'index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1' }}">
  <link rel="canonical" href="{{ canonical }}">
  <meta name="theme-color" content="#0F1B2A">
  <meta name="geo.region" content="PK-PB">
  <meta name="geo.placename" content="{{ geoPlace or 'Lahore' }}">
  {% if geoPosition %}<meta name="geo.position" content="{{ geoPosition }}"><meta name="ICBM" content="{{ geoPosition | replace(';', ', ') }}">{% endif %}

  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:locale" content="{{ site.locale }}">
  <meta property="og:type" content="{{ 'article' if pageType == 'post' else 'website' }}">
  <meta property="og:title" content="{{ seoTitle }}">
  <meta property="og:description" content="{{ seoDescription }}">
  <meta property="og:url" content="{{ canonical }}">
  <meta property="og:image" content="{{ shareImage }}">
  <meta property="og:image:alt" content="{{ (image_alt or (site.fullName ~ ', ' ~ site.jobTitle)) }}">
  {% if not image %}<meta property="og:image:width" content="1200"><meta property="og:image:height" content="630">{% endif %}
  {% if pageType == 'post' %}
  <meta property="article:published_time" content="{{ page.date | isoDateTime }}">
  <meta property="article:modified_time" content="{{ page.inputPath | lastModified | isoDateTime }}">
  <meta property="article:author" content="{{ '/about/' | abs }}">
  <meta property="article:section" content="{{ category }}">
  {% else %}
  <meta property="og:updated_time" content="{{ page.inputPath | lastModified | isoDateTime }}">
  {% endif %}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ seoTitle }}">
  <meta name="twitter:description" content="{{ seoDescription }}">
  <meta name="twitter:image" content="{{ shareImage }}">
  {% if site.analytics.googleVerification %}<meta name="google-site-verification" content="{{ site.analytics.googleVerification }}">{% endif %}
  {% if site.analytics.bingVerification %}<meta name="msvalidate.01" content="{{ site.analytics.bingVerification }}">{% endif %}

  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
  <link rel="stylesheet" href="/assets/css/main.css">
  {#- Fonts and icons load without blocking the first paint (faster pages rank better) -#}
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Manrope:wght@400;500;600;700&family=Noto+Nastaliq+Urdu:wght@400;600&display=swap" onload="this.onload=null;this.rel='stylesheet'">
  <link rel="preload" as="style" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" onload="this.onload=null;this.rel='stylesheet'" referrerpolicy="no-referrer">
  <noscript>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Manrope:wght@400;500;600;700&family=Noto+Nastaliq+Urdu:wght@400;600&display=swap">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  </noscript>
  <link rel="alternate" type="text/plain" title="Summary for AI assistants" href="/llms.txt">
  <link rel="sitemap" type="application/xml" href="/sitemap.xml">
  {% if preloadImage %}<link rel="preload" as="image" href="{{ preloadImage }}">{% endif %}

  {% include "partials/schema.njk" %}

  {% if site.analytics.ga4 %}
  <script async src="https://www.googletagmanager.com/gtag/js?id={{ site.analytics.ga4 }}"></script>
  <script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','{{ site.analytics.ga4 }}');</script>
  {% endif %}
  {% if site.analytics.metaPixel %}
  <script>!function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');fbq('init','{{ site.analytics.metaPixel }}');fbq('track','PageView');</script>
  {% endif %}
</head>
<body class="page-{{ pageType or 'page' }}" data-whatsapp="{{ site.whatsapp }}"{% if consultProcedure %} data-procedure="{{ consultProcedure }}"{% endif %}>
  <a class="skip-link" href="#main">Skip to content</a>
  <div id="google_translate_element" aria-hidden="true"></div>

  {% include "partials/header.njk" %}

  <main id="main">
    {{ content | safe }}
  </main>

  {% include "partials/footer.njk" %}
  {% include "partials/consult-form.njk" %}

  {% set floating = true %}{% include "partials/lang-toggle.njk" %}{% set floating = false %}

  <a class="wa-float" href="{{ '' | waLink }}" data-consult aria-label="Message Dr. Junaid on WhatsApp">
    <i class="fab fa-whatsapp" aria-hidden="true"></i>
  </a>

  <script src="/assets/js/main.js" defer></script>
</body>
</html>

---
layout: layouts/base.njk
---
{%- set crumbs = [{ name: "Procedures", url: "/procedures/" }, { name: nav_title }] -%}
{%- set heroActions = true -%}
{%- set items = collections.procedures | byCategory(page.fileSlug) -%}
{% include "partials/page-hero.njk" %}

<section class="section">
  <div class="container cat-intro">
    <div class="prose prose--lead">
      {{ content | safe }}
    </div>
    <aside class="cat-intro__aside">
      <div class="aside-card aside-card--doctor">
        <img src="/assets/images/doctor/dr-junaid-fateh-square.webp" alt="{{ site.fullName }}" width="88" height="88" loading="lazy">
        <p class="aside-card__name">{{ site.fullName }}</p>
        <p class="aside-card__cred">{{ site.shortCredentials }}</p>
        <a class="btn btn--gold btn--block" href="{{ '' | waLink }}" data-consult><i class="fas fa-calendar-check" aria-hidden="true"></i> Book Consultation</a>
      </div>
      <div class="aside-card">
        <p class="aside-card__title"><i class="fas fa-list" aria-hidden="true"></i> {{ nav_title }} procedures</p>
        <ul class="aside-links">
          {% for p in items %}<li><a href="{{ p.url }}">{{ p.data.short_title }} <i class="fas fa-chevron-right" aria-hidden="true"></i></a></li>{% endfor %}
        </ul>
      </div>
    </aside>
  </div>
</section>

{% if estimator and page.fileSlug == "hair-restoration" %}
<section class="section section--sand">
  <div class="container">
    {% include "partials/estimator.njk" %}
  </div>
</section>
{% endif %}

<section class="section{% if not (estimator and page.fileSlug == 'hair-restoration') %} section--sand{% endif %}">
  <div class="container">
    <div class="section__head">
      <p class="eyebrow">Treatments</p>
      <h2>{{ title }} with Dr. Junaid</h2>
    </div>
    <div class="card-grid">
      {% for p in items %}{% include "partials/procedure-card.njk" %}{% endfor %}
    </div>
  </div>
</section>

{%- set catResults = items | allResults -%}
{% if catResults.length %}
<section class="section">
  <div class="container">
    <div class="section__head">
      <p class="eyebrow">Results</p>
      <h2>Before &amp; after</h2>
    </div>
    <div class="ba-list ba-list--grid">
      {% for pair in catResults | limit(4) %}{% set label = pair.procedure %}{% include "partials/before-after.njk" %}{% endfor %}
    </div>
    <p class="center"><a class="btn btn--outline" href="/gallery/">View the full gallery</a></p>
  </div>
</section>
{% endif %}

{%- set catVideos = items | allVideos -%}
{% if catVideos.length %}
<section class="section section--sand">
  <div class="container">
    <div class="section__head"><p class="eyebrow">Watch</p><h2>Videos</h2></div>
    {% set videoList = catVideos | limit(6) %}{% set socialList = [] %}{% set videoLabel = title %}
    {% include "partials/videos-block.njk" %}
  </div>
</section>
{% endif %}

{% if faqs and faqs.length %}
<section class="section">
  <div class="container container--narrow">
    <div class="section__head"><p class="eyebrow">Questions</p><h2>{{ nav_title }} FAQs</h2></div>
    {% set faqList = faqs %}{% set faqOpenFirst = true %}
    {% include "partials/faq-list.njk" %}
  </div>
</section>
{% endif %}

{% include "partials/cta-band.njk" %}

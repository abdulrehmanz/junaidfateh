{# WhatsApp consultation form. Opened by any element with the data-consult attribute. #}
<div class="modal" id="consult-modal" role="dialog" aria-modal="true" aria-labelledby="consult-title" hidden>
  <div class="modal__backdrop" data-modal-close></div>
  <div class="modal__box">
    <button class="modal__close" type="button" aria-label="Close" data-modal-close><i class="fas fa-xmark" aria-hidden="true"></i></button>
    <div class="modal__head">
      <img src="/assets/images/doctor/dr-junaid-fateh-square.webp" alt="" width="56" height="56" loading="lazy">
      <div>
        <h2 id="consult-title">Book a consultation</h2>
        <p>Fill in a few details and WhatsApp opens with your message ready to send.</p>
      </div>
    </div>
    <form class="consult-form" id="consult-form" novalidate>
      <div class="field">
        <label for="cf-name">Your name <span aria-hidden="true">*</span></label>
        <input id="cf-name" name="name" type="text" autocomplete="name" required placeholder="e.g. Ahmed Khan">
      </div>
      <div class="field-row">
        <div class="field">
          <label for="cf-phone">Phone number</label>
          <input id="cf-phone" name="phone" type="tel" autocomplete="tel" placeholder="e.g. 0300 1234567">
        </div>
        <div class="field">
          <label for="cf-city">City / country</label>
          <input id="cf-city" name="city" type="text" autocomplete="address-level2" placeholder="e.g. Lahore or Dubai">
        </div>
      </div>
      <div class="field">
        <label for="cf-procedure">Treatment you are interested in <span aria-hidden="true">*</span></label>
        <select id="cf-procedure" name="procedure" required>
          <option value="">Select a treatment</option>
          {% for cat in collections.categories %}
          <optgroup label="{{ cat.data.nav_title }}">
            {% for p in collections.procedures | byCategory(cat.fileSlug) %}
            <option value="{{ p.data.title }}">{{ p.data.short_title }}</option>
            {% endfor %}
          </optgroup>
          {% endfor %}
          <option value="Not sure yet">Not sure yet / general advice</option>
        </select>
      </div>
      <div class="field">
        <span class="field__label" id="cf-loc-label">Where would you like to be seen?</span>
        <div class="chips" role="radiogroup" aria-labelledby="cf-loc-label">
          {% for loc in locations %}
          <label class="chip"><input type="radio" name="location" value="{{ loc.city }}"{% if loop.first %} checked{% endif %}><span>{{ loc.city }}</span></label>
          {% endfor %}
          <label class="chip"><input type="radio" name="location" value="Online video consultation"><span>Online</span></label>
        </div>
      </div>
      <div class="field">
        <label for="cf-message">Anything else? <small>(optional)</small></label>
        <textarea id="cf-message" name="message" rows="3" placeholder="Your questions, preferred days, or anything Dr. Junaid should know"></textarea>
      </div>
      <p class="form-error" role="alert" hidden></p>
      <button class="btn btn--wa btn--block btn--lg" type="submit"><i class="fab fa-whatsapp" aria-hidden="true"></i> Continue on WhatsApp</button>
      <p class="modal__note"><i class="fas fa-lock" aria-hidden="true"></i> Your details go straight to Dr. Junaid's WhatsApp and are not stored on this website. <a href="{{ '' | waLink }}" target="_blank" rel="noopener" data-direct>Skip the form</a></p>
    </form>
  </div>
</div>

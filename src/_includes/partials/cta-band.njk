<section class="cta-band">
  <div class="container cta-band__inner">
    <div>
      <p class="eyebrow eyebrow--light">Take the first step</p>
      <h2>{{ ctaTitle or "Talk to Dr. Junaid about your goals" }}</h2>
      <p>{{ ctaText or "Book a consultation in Lahore, or start with a video consultation from anywhere in the world." }}</p>
    </div>
    <div class="cta-band__actions">
      <a class="btn btn--gold btn--lg" href="{{ '' | waLink }}" data-consult{% if consultProcedure %} data-procedure="{{ consultProcedure }}"{% endif %}><i class="fas fa-calendar-check" aria-hidden="true"></i> Book Consultation</a>
      <a class="btn btn--ghost-light btn--lg" href="tel:{{ site.phoneHref }}"><i class="fas fa-phone" aria-hidden="true"></i> {{ site.phone }}</a>
    </div>
  </div>
</section>

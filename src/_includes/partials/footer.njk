<footer class="site-footer">
  <div class="container footer__grid">
    <div class="footer__about">
      <a class="brand brand--light" href="/">
        <span class="brand__mark" aria-hidden="true">JF</span>
        <span class="brand__text">
          <span class="brand__name">{{ site.name }}</span>
          <span class="brand__role">{{ site.shortCredentials }}</span>
        </span>
      </a>
      <p>{{ site.jobTitle }}. FCPS-trained at Jinnah Burn &amp; Reconstructive Surgery Centre, Lahore, and a member of the Pakistan Association of Plastic Surgeons.</p>
      {% include "partials/social-icons.njk" %}
    </div>

    <div>
      <h2 class="footer__title">Signature Specialties</h2>
      <ul class="footer__links">
        <li><a href="/hair-transplant/">Hair Transplant</a></li>
        <li><a href="/procedures/gynecomastia/">Gynecomastia Surgery</a></li>
        <li><a href="/procedures/liposuction/">Liposuction</a></li>
        <li><a href="/procedures/non-surgical/">Botox, Fillers &amp; Skin</a></li>
        <li><a href="/procedures/hand-surgery/">Hand Surgery</a></li>
        <li><a href="/procedures/reconstructive-surgery/">Reconstructive Surgery</a></li>
        <li><a href="/procedures/">All Procedures</a></li>
      </ul>
    </div>

    <div>
      <h2 class="footer__title">Patients</h2>
      <ul class="footer__links">
        <li><a href="/about/">About Dr. Junaid</a></li>
        <li><a href="/plastic-surgeon-lahore/">Plastic Surgeon in Lahore</a></li>
        <li><a href="/plastic-surgeon-layyah/">Plastic Surgeon in Layyah</a></li>
        <li><a href="/patient-journey/">Your Patient Journey</a></li>
        <li><a href="/cost-guide/">Cost Guide</a></li>
        <li><a href="/overseas-patients/">Overseas Patients</a></li>
        <li><a href="/gallery/">Before &amp; After</a></li>
        <li><a href="/reviews/">Reviews</a></li>
        <li><a href="/videos/">Videos</a></li>
        <li><a href="/blog/">Blog</a></li>
        <li><a href="/faq/">FAQs</a></li>
      </ul>
    </div>

    <div class="footer__contact">
      <h2 class="footer__title">Clinics &amp; Contact</h2>
      {% for loc in locations %}
      <div class="footer__loc">
        <strong><i class="fas fa-location-dot" aria-hidden="true"></i> {{ loc.city }}{% if loc.clinic %} &middot; {{ loc.clinic }}{% endif %}</strong>
        {% if loc.address %}<span>{{ loc.address }}{% if loc.postalCode %}, {{ loc.city }} {{ loc.postalCode }}{% endif %}</span>{% else %}<span>Address shared when you book</span>{% endif %}
        {% if loc.days or loc.hours %}<span>{{ loc.days }}{% if loc.days and loc.hours %}, {% endif %}{{ loc.hours }}</span>{% endif %}
        {% if loc.mapsUrl %}<a href="{{ loc.mapsUrl }}" target="_blank" rel="noopener">Get directions</a>{% endif %}
      </div>
      {% endfor %}
      <ul class="footer__links footer__links--contact">
        <li><a href="{{ '' | waLink }}" data-consult><i class="fab fa-whatsapp" aria-hidden="true"></i> WhatsApp {{ site.phone }}</a></li>
        <li><a href="tel:{{ site.phoneHref }}"><i class="fas fa-phone" aria-hidden="true"></i> {{ site.phone }}</a></li>
        <li><a href="mailto:{{ site.email }}"><i class="fas fa-envelope" aria-hidden="true"></i> {{ site.email }}</a></li>
      </ul>
    </div>
  </div>

  <div class="footer__bottom">
    <div class="container footer__bottom-inner">
      <p>&copy; {% year %} {{ site.fullName }}. All rights reserved.</p>
      <p class="footer__legal"><a href="/privacy/">Privacy Policy</a> &middot; <a href="/terms/">Terms &amp; Medical Disclaimer</a> &middot; <a href="/editorial-policy/">Editorial Policy</a> &middot; <a href="/sitemap.xml">Sitemap</a></p>
    </div>
    <p class="container footer__disclaimer">The information on this website is general and is not a substitute for a personal medical consultation. Results vary from person to person.</p>
  </div>
</footer>

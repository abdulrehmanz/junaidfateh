<div class="lang-toggle{% if floating %} lang-toggle--float{% endif %} notranslate" role="group" aria-label="Language" translate="no">
  <i class="fas fa-globe" aria-hidden="true"></i>
  <button type="button" class="lang-toggle__opt is-active" data-lang="en" aria-pressed="true">EN</button>
  <button type="button" class="lang-toggle__opt" data-lang="ur" aria-pressed="false" lang="ur">اردو</button>
</div>

    </div>
    <div class="section__foot"><a class="btn btn--outline" href="/reviews/">All reviews</a></div>
  </div>
</section>
{% endif %}

<section class="section section--sand">
  <div class="container">
    <div class="section__head reveal"><p class="eyebrow">Clinic</p><h2>Where to see Dr. Junaid</h2></div>
    <div class="loc-grid">{% for loc in locations %}{% include "partials/location-card.njk" %}{% endfor %}</div>
  </div>
</section>


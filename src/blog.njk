{%- set crumbs = [{ name: "Blog" }] -%}
{% include "partials/page-hero.njk" %}

<section class="section">
  <div class="container">
    {%- set seenCats = "" -%}
    <div class="filter-bar" data-filter-group="#post-grid" role="group" aria-label="Filter articles">
      <button type="button" class="is-active" data-filter="all" aria-pressed="true">All</button>
      {% for post in collections.posts %}{% set key = post.data.category | slugify %}{% if ("|" ~ key ~ "|") not in seenCats %}{% set seenCats = seenCats ~ "|" ~ key ~ "|" %}<button type="button" data-filter="{{ key }}" aria-pressed="false">{{ post.data.category }}</button>{% endif %}{% endfor %}
    </div>
    <div class="post-grid" id="post-grid">
      {% for post in collections.posts %}<div data-filter-item="{{ post.data.category | slugify }}" style="display:flex">{% include "partials/post-card.njk" %}</div>{% endfor %}
    </div>
  </div>
</section>

{% include "partials/cta-band.njk" %}
